# Public web values only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side secrets: replace locally or in CI/CD secrets; never commit real values
DATABASE_URL=<database connection URL>
DATABASE_USERNAME=<database user>
DATABASE_PASSWORD=<database password>
CACHE_URL=<cache connection URL>
STORAGE_ENDPOINT=<object storage endpoint>
STORAGE_BUCKET=<object storage bucket>
STORAGE_ACCESS_KEY=<storage access key>
STORAGE_SECRET_KEY=<storage secret key>
AI_API_KEY=<AI provider API key>
PAYMENT_CLIENT_KEY=<payment client key>
PAYMENT_SECRET_KEY=<payment secret key>
DEPLOYMENT_TOKEN=<deployment token>
